<svg xmlns="http://www.w3.org/2000/svg" width="600" height="200" viewBox="0 0 600 200">
  <defs>
    <linearGradient id="stickGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#EED5AD"/>
      <stop offset="50%" stop-color="#F8E5C4"/>
      <stop offset="100%" stop-color="#E5C79A"/>
    </linearGradient>
  </defs>
  <rect width="600" height="200" fill="#FFFCEB"/>
  <rect x="40" y="60" width="520" height="80" rx="40" ry="40" fill="url(#stickGrad)" stroke="#C8A572" stroke-width="4"/>
  <text x="300" y="110" font-family="'Comic Sans MS', 'Fredoka', cursive, sans-serif" font-size="20" font-weight="bold" fill="#0F172A" text-anchor="middle">
    Solar study lamps for children in off-grid villages 💡
  </text>
</svg>
