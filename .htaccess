<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Route API requests to backend/api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} api/ [NC]
  RewriteRule ^(.*)api/(.*)$ backend/api/$2 [L]

  # 2. Route Uploads requests to backend/uploads/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} uploads/ [NC]
  RewriteRule ^(.*)uploads/(.*)$ backend/uploads/$2 [L]

  # 3. If whole project is uploaded, route root/index.html requests to dist/index.html
  RewriteCond dist/index.html -f
  RewriteRule ^(index\.html)?$ dist/index.html [L]

  # 4. Route asset requests to dist/assets/ if dist/assets exists
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond dist/assets/$1 -f
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

  # 5. Route SPA pages & main URL fallback
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond dist/index.html -f
  RewriteRule ^ dist/index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
