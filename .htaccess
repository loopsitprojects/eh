# Set default index page to dist/index.html first
DirectoryIndex dist/index.html index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Define base directory for subfolder deployment
  RewriteBase /

  # 1. Route API requests to backend/api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} api/ [NC]
  RewriteRule ^(.*)api/(.*)$ backend/api/$2 [L]

  # 2. Route Uploads requests to backend/uploads/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} uploads/ [NC]
  RewriteRule ^(.*)uploads/(.*)$ backend/uploads/$2 [L]

  # 3. Route root / or index.html requests directly to dist/index.html
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteRule ^(index\.html)?$ dist/index.html [L]

  # 4. Route asset & favicon requests to dist/ directory if not found in root
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^favicon\.svg$ dist/favicon.svg [L]

  # 5. SPA Fallback for all other non-file/non-directory routes
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ dist/index.html [L]
</IfModule>
